---
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const projects = [
  {
    name: "Brain's Lab",
    description:
      'A personal research site for notes and explorations in Embodied AI, VLA, computer vision, and robot learning.',
    links: [
      { type: 'github', href: 'https://github.com/zmxdk3/zmxdk3.github.io' },
      { type: 'site', href: 'https://zmxdk3.github.io/' }
    ]
  }
]
---

<PageLayout title='Projects'>
  <div
    class='not-prose mb-10 overflow-hidden rounded-2xl border bg-muted/30 px-5 py-8 sm:px-8 sm:py-10'
  >
    <div class='max-w-2xl'>
      <div class='mb-4 flex items-center gap-2 text-sm font-medium text-muted-foreground'>
        <span class='size-2 rounded-full bg-green-500'></span>
        Building and learning in public
      </div>
      <h2 class='m-0 text-2xl font-semibold tracking-tight sm:text-3xl'>
        Exploring intelligent systems through code
      </h2>
      <p class='mb-6 mt-3 leading-relaxed text-muted-foreground'>
        A growing collection of projects, experiments, and research notes focused on embodied
        intelligence and visual learning.
      </p>
      <Button
        title='View GitHub profile'
        class='w-fit'
        href='https://github.com/zmxdk3'
        target='_blank'
      >
        <Icon class='size-5' name='github' slot='before' />
      </Button>
    </div>
  </div>

  <section class='not-prose' aria-labelledby='featured-projects'>
    <div class='mb-5'>
      <h2 id='featured-projects' class='m-0 text-xl font-semibold'>Featured project</h2>
      <p class='mb-0 mt-1 text-sm text-muted-foreground'>
        More work will be added as it becomes public.
      </p>
    </div>
    <ProjectSection {projects} />
  </section>
</PageLayout>
